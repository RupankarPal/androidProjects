<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="0dp"
    app:cardCornerRadius="0dp"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Row 1: Name and P&L -->
        <TextView
            android:id="@+id/stock_name_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GOLDBEES"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/PL_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-393.36 (-2.48%)"
            android:textColor="@color/Red"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Row 2: Invested and Avg -->
        <TextView
            android:id="@+id/lbl_invested_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Invested "
            android:textSize="14sp"
            android:textColor="#888888"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/stock_name_txt" />

        <TextView
            android:id="@+id/invested_amount_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15,886.20"
            android:textSize="14sp"
            android:textColor="#555555"
            app:layout_constraintStart_toEndOf="@id/lbl_invested_val"
            app:layout_constraintTop_toTopOf="@id/lbl_invested_val" />

        <TextView
            android:id="@+id/purchasing_price_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="120.35 Avg"
            android:textSize="14sp"
            android:textColor="#555555"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/lbl_invested_val" />

        <!-- Row 3: Qty and LTP -->
        <TextView
            android:id="@+id/lbl_qty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Qty "
            android:textSize="14sp"
            android:textColor="#888888"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lbl_invested_val" />

        <TextView
            android:id="@+id/Quentity_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="132"
            android:textSize="14sp"
            android:textColor="#555555"
            app:layout_constraintStart_toEndOf="@id/lbl_qty"
            app:layout_constraintTop_toTopOf="@id/lbl_qty" />

        <TextView
            android:id="@+id/share_price_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="117.37"
            android:textSize="14sp"
            android:textColor="@color/Green"
            app:layout_constraintEnd_toStartOf="@id/percentile_txt"
            app:layout_constraintTop_toTopOf="@id/lbl_qty" />

        <TextView
            android:id="@+id/percentile_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" (+0.45%) LTP"
            android:textSize="14sp"
            android:textColor="@color/Green"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/lbl_qty" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F0F0"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/lbl_qty" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
