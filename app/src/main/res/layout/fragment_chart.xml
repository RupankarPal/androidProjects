<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.cardview.widget.CardView
        android:id="@+id/chart_feature_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btn_interval_selector"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="1D"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="?attr/selectableItemBackground" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="#DDDDDD"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/btn_indicators"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Indicators"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="?attr/selectableItemBackground" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="#DDDDDD"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <ImageView
                android:id="@+id/btn_drawings"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:src="@drawable/baseline_add_shopping_cart_24"
                app:tint="@color/black"
                android:background="?attr/selectableItemBackground" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <FrameLayout
        android:id="@+id/chart_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chart_feature_bar">

        <com.tradingview.lightweightcharts.view.ChartsView
            android:id="@+id/chart_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Overlay for drawings -->
        <com.example.bottonnavigation_and_recyclerview_implement_homepage.chart.DrawingOverlayView
            android:id="@+id/drawing_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <!-- Container for active indicator labels -->
        <LinearLayout
            android:id="@+id/active_indicators_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="top|start"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
